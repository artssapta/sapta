{
  "name": "sapta",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "admin": "node admin-server.mjs",
    "admin:dev": "wrangler dev",
    "admin:deploy": "npm test && wrangler deploy && wrangler deploy --env preview",
    "dev:all": "node admin-server.mjs & astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "images": "node scripts/optimize-images.mjs",
    "test": "node --test tests/*.test.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^6.3.3",
    "js-yaml": "^4.2.0"
  },
  "devDependencies": {
    "sharp": "^0.34.5",
    "wrangler": "^4.148.0"
  }
}
