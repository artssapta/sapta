---
import { responsiveImage } from '../../lib/images.mjs';
const { title, text, image, imageSide = "right" } = Astro.props;
const pic = responsiveImage(image, { sizes: '(max-width: 768px) 320px, 480px' });

const resolvePath = (path: string) => {
  if (path && path.startsWith('/')) {
    const base = import.meta.env.BASE_URL;
    const cleanBase = base.endsWith('/') ? base.slice(0, -1) : base;
    return `${cleanBase}${path}`;
  }
  return path;
};
---
<div class="about-section">
    <div class={`about-grid ${imageSide === 'left' ? 'image-left' : 'image-right'}`}>
        {imageSide === 'left' && (
            <div class="about-img reveal reveal-left">
                <img src={resolvePath(pic.src)} srcset={pic.srcset} sizes={pic.sizes} width={pic.width} height={pic.height} alt={title} loading="lazy" decoding="async" />
            </div>
        )}
        <div class="about-text reveal reveal-right">
            {title && <h2 class="section-title">{title}</h2>}
            <p>{text}</p>
        </div>
        {imageSide !== 'left' && (
            <div class="about-img reveal reveal-right">
                <img src={resolvePath(pic.src)} srcset={pic.srcset} sizes={pic.sizes} width={pic.width} height={pic.height} alt={title} loading="lazy" decoding="async" />
            </div>
        )}
    </div>
</div>

<style>
    .about-section {
        max-width: 1120px;
        margin: 0 auto;
        padding: 72px 48px;
    }

    .section-title {
        font-family: 'Lora', serif;
        font-size: 28pt;
        color: #316fa6;
        text-align: left;
        margin-bottom: 18px;
        margin-top: 0;
        font-weight: 400;
        letter-spacing: normal;
        line-height: 1.2;
    }

    .about-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 72px;
        align-items: start;
    }

    .about-grid.image-left {
        grid-template-columns: 1fr 1.2fr;
    }

    .about-text {
        font-family: 'Gentium Basic', serif;
        font-size: 16pt;
        line-height: 1.8;
        color: #405258;
        text-align: left;
    }

    .about-img img {
        width: 100%;
        height: auto; /* the img has width/height attributes (stops layout jumps) */
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: 18px;
        box-shadow: 0 18px 42px rgba(34,65,70,0.15);
    }

    @media (max-width: 768px) {
        .about-grid {
            grid-template-columns: 1fr;
            text-align: center;
        }
        .about-img {
            max-width: 320px;
            margin: 20px auto 0;
        }
        .about-grid.image-left .about-img {
            margin: 0 auto 20px;
        }
        .about-section {
            padding: 30px 24px;
        }
        .section-title {
            font-size: 24pt;
        }
    }

    /* Phones: a comfortable reading size, left-aligned for easy reading. */
    @media (max-width: 600px) {
        .about-grid { text-align: left; }
        .about-text p {
            font-size: 13pt;
            line-height: 1.7;
        }
    }
</style>
