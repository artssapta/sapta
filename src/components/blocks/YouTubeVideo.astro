---
const { videoUrl, title } = Astro.props;

// Robustly extract the video ID from any YouTube URL format:
// - https://www.youtube.com/watch?v=XXXX
// - https://www.youtube.com/embed/XXXX
// - https://youtu.be/XXXX
function extractVideoId(url: string): string {
    if (!url) return '';
    // Already just an ID (11 chars, no slashes)
    if (/^[a-zA-Z0-9_-]{11}$/.test(url)) return url;
    // watch?v= format
    const watchMatch = url.match(/[?&]v=([a-zA-Z0-9_-]{11})/);
    if (watchMatch) return watchMatch[1];
    // youtu.be/ or /embed/ format
    const pathMatch = url.match(/(?:youtu\.be\/|\/embed\/|\/v\/)([a-zA-Z0-9_-]{11})/);
    if (pathMatch) return pathMatch[1];
    // Fallback: last path segment
    return url.split('/').pop()?.split('?')[0] || '';
}

const videoId = extractVideoId(videoUrl);
---
<div class="video-wrapper reveal">
    {title && <h3 class="video-title">{title}</h3>}
    {videoId ? (
        <div class="video-container">
            <iframe
                src={`https://www.youtube.com/embed/${videoId}?rel=0&modestbranding=1`}
                title={title || "YouTube video player"}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
            ></iframe>
        </div>
    ) : (
        <p class="video-error">Video unavailable.</p>
    )}
</div>

<style>
    .video-wrapper {
        max-width: 820px;
        margin: 28px auto;
        padding: 0 20px;
    }
    .video-title {
        margin-bottom: 16px;
        font-family: 'Lora', serif;
        font-size: 1.6rem;
        font-weight: 400;
        color: #1e6c93;
        text-align: center;
    }
    /* True 16:9 responsive container */
    .video-container {
        position: relative;
        width: 100%;
        padding-top: 56.25%; /* 16:9 */
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 6px 24px rgba(0,0,0,0.10);
    }
    .video-container iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: none;
    }
    .video-error {
        text-align: center;
        color: #888;
        font-style: italic;
    }
</style>
