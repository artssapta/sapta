---
const { title, subtitle, color = "#316fa6", showDonate = false } = Astro.props;
const resolvePath = (p) => p && p.startsWith('/') ? `${import.meta.env.BASE_URL.replace(/\/$/, '')}${p}` : p;
const bgImage = resolvePath("/assets/hero_music_banner.png");
---
<section class="hero" style={`background-image: url(${bgImage}); background-color: ${color};`}>
    <div class="hero-overlay"></div>
    <div class="hero-content reveal">
        <h1>{title}</h1>
        {subtitle && <p class="hero-subtitle">{subtitle}</p>}
        {showDonate && (
            <div class="hero-cta">
                <a href="#donate" class="btn-hero-donate">Support Our Mission</a>
        <a href={resolvePath('/events')} class="btn-hero-events">View Events</a>
            </div>
        )}
    </div>
</section>

<style>
    .hero {
        position: relative;
        min-height: 470px;
        background-size: cover;
        background-position: center;
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        color: white;
        margin-bottom: 0;
        overflow: hidden;
    }

    /* Layered overlay: deep gradient bottom + subtle teal top */
    .hero-overlay {
        position: absolute;
        inset: 0;
        background:
            linear-gradient(
                to bottom,
                rgba(22, 70, 75, 0.38) 0%,
                rgba(15, 50, 55, 0.82) 100%
            );
        z-index: 1;
    }

    /* Subtle animated shimmer */
    .hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at 60% 40%, rgba(73,170,212,0.12) 0%, transparent 65%);
        z-index: 1;
        animation: shimmer 6s ease-in-out infinite alternate;
    }
    @keyframes shimmer {
        from { opacity: 0.6; }
        to   { opacity: 1; }
    }

    .hero-content {
        position: relative;
        z-index: 2;
        padding: 60px 48px;
        max-width: 980px;
    }

    /* Override reveal animation inside hero — always visible */
    .hero-content.reveal {
        opacity: 0;
        animation: heroFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
        transform: none;
    }
    .hero-content.visible {
        opacity: 1;
    }
    @keyframes heroFadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .hero h1 {
        font-family: 'Lora', serif;
        font-size: clamp(48pt, 8vw, 78pt);
        font-weight: 500;
        line-height: 1;
        letter-spacing: -1px;
        margin-top: 40px;
        margin-bottom: 0;
        color: white;
        text-shadow: 0 2px 16px rgba(0,0,0,0.3);
    }

    .hero-subtitle {
        font-family: 'Lora', serif;
        font-size: clamp(17pt, 3vw, 28pt);
        font-weight: 400;
        line-height: 1.1;
        margin-top: 20px;
        color: rgba(255,255,255,0.94);
        text-shadow: 0 1px 8px rgba(0,0,0,0.25);
    }

    /* CTA buttons (only shown on homepage via showDonate prop) */
    .hero-cta {
        display: flex;
        gap: 14px;
        justify-content: center;
        margin-top: 32px;
        flex-wrap: wrap;
    }
    .btn-hero-donate {
        display: inline-block;
        padding: 13px 28px;
        background: #f1cf3b;
        color: #1d4770;
        font-family: 'Inter', sans-serif;
        font-size: 10.5pt;
        font-weight: 700;
        border-radius: 24px;
        text-decoration: none;
        letter-spacing: 0.3px;
        transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
        box-shadow: 0 4px 14px rgba(0,0,0,0.18);
    }
    .btn-hero-donate:hover {
        background: #fff0a8;
        transform: translateY(-2px);
        box-shadow: 0 8px 22px rgba(0,0,0,0.22);
    }
    .btn-hero-events {
        display: inline-block;
        padding: 13px 28px;
        background: transparent;
        color: #ffffff;
        font-family: 'Inter', sans-serif;
        font-size: 10.5pt;
        font-weight: 600;
        border-radius: 24px;
        border: 2px solid rgba(255,255,255,0.7);
        text-decoration: none;
        letter-spacing: 0.3px;
        transition: background 0.2s, border-color 0.2s, transform 0.2s;
    }
    .btn-hero-events:hover {
        background: rgba(255,255,255,0.12);
        border-color: rgba(255,255,255,1);
        transform: translateY(-2px);
    }

    @media (max-width: 767px) {
        .hero { min-height: 380px; }
        .hero h1 { font-size: 38pt; }
        .hero-subtitle { font-size: 17pt; max-width: 30rem; margin-left: auto; margin-right: auto; }
        .hero-content { padding: 40px 24px; }
        .btn-hero-donate, .btn-hero-events { padding: 11px 22px; font-size: 10pt; }
    }
</style>
