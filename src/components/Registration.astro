---
import { registrationLink, checkFormEmbed } from '../lib/media.mjs';
const { title, status, message, openMessage, url } = Astro.props;
const link = registrationLink(url);
const isOpen = status === 'open' && link;
// Google Forms (incl. forms.gle short links) are embedded in the page;
// other links get a button. KEEP IN SYNC with admin/core/render-preview.mjs.
const { embed = null, signIn = false } = isOpen ? await checkFormEmbed(link) : {};
const visitorMessage = isOpen
  ? (openMessage || (embed ? 'Registration is open! Fill in the form below.' : 'Registration is open! Use the button below to open the form.'))
  : message;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="registration" aria-labelledby="registration-title">
  <p class="eyebrow">Perform with SAPTA</p>
  <h1 id="registration-title">{title}</h1>
  <div class="notice">
    <p class="status">{isOpen ? 'Registration is open' : 'Coming soon'}</p>
    <p class="message">{visitorMessage}</p>
    {!isOpen && <p class="note">The new registration link will appear on this page when it’s ready.</p>}
    {isOpen && !embed && <a class="action" href={link} target="_blank" rel="noopener noreferrer">Open registration form <span aria-hidden="true">↗</span></a>}
    {isOpen && !embed && <p class="note">The form opens in a new tab.</p>}
  </div>
  {embed && (
    <div class="form-embed">
      {signIn && <p class="note sign-in-note">This form asks you to sign in with Google. If signing in doesn’t work here, <a href={link} target="_blank" rel="noopener noreferrer">open the form in a new tab <span aria-hidden="true">↗</span></a></p>}
      <iframe src={embed} title={`${title} form`} loading="lazy">Loading the registration form…</iframe>
      <p class="note">Can’t see the form? <a href={link} target="_blank" rel="noopener noreferrer">Open it in a new tab <span aria-hidden="true">↗</span></a></p>
    </div>
  )}
  <div class="links">
    <a href={`${base}/events/`}>Explore our events <span aria-hidden="true">→</span></a>
    <a href="mailto:artssapta@gmail.com">Contact us</a>
  </div>
</section>
{embed && (
  <script is:inline>
    // Some Google Forms (those asking visitors to sign in) move keyboard focus
    // into the form just after loading, which makes the browser jump down the
    // page. Undo that one jump only: within 10 s of loading, before the
    // visitor has touched the page, and only once, so it never fights them.
    (() => {
      const frame = document.querySelector('.form-embed iframe');
      if (!frame) return;
      const until = performance.now() + 10000;
      let keepY = window.scrollY;
      let armed = true;
      const disarm = () => { armed = false; };
      for (const type of ['pointerdown', 'keydown', 'touchstart', 'wheel']) {
        window.addEventListener(type, disarm, { once: true, passive: true, capture: true });
      }
      window.addEventListener('scroll', () => {
        if (armed && performance.now() < until && document.activeElement === frame && Math.abs(window.scrollY - keepY) > 150) {
          armed = false;
          window.scrollTo(0, keepY);
          return;
        }
        if (document.activeElement !== frame) keepY = window.scrollY;
      }, { passive: true });
    })();
  </script>
)}
<style>
  .registration { max-width: 800px; margin: 0 auto; padding: 88px 24px 100px; }
  .eyebrow { font: 600 12px 'Inter', sans-serif; letter-spacing: .12em; text-transform: uppercase; color: #526874; margin-bottom: 18px; }
  h1 { font: 400 clamp(32px, 5vw, 52px)/1.15 'Lora', serif; color: #1d4770; margin-bottom: 38px; }
  .notice { border-top: 3px solid #e4bd32; border-bottom: 1px solid #d8dedc; padding: 32px 0; }
  .status { font: 500 26px 'Lora', serif; color: #1d4770; margin-bottom: 14px; }
  .message { font-size: 21px; line-height: 1.65; max-width: 600px; }
  .note { font: 400 14px/1.6 'Inter', sans-serif; color: #58676c; margin-top: 22px; }
  .action { display: inline-flex; gap: 24px; margin-top: 26px; padding: 14px 22px; border-radius: 6px; background: #245681; color: white; font: 500 15px 'Inter', sans-serif; text-decoration: none; }
  .action:hover { background: #1d4770; }
  .form-embed { margin-top: 32px; }
  .form-embed iframe { display: block; width: 100%; height: 1500px; border: 1px solid #d8dedc; border-radius: 8px; background: #fff; }
  .form-embed .note { margin-top: 12px; }
  .form-embed .sign-in-note { margin: 0 0 12px; padding: 12px 16px; background: #fff8e1; border-left: 3px solid #e4bd32; color: #3d4a4f; }
  .form-embed .note a { color: #245681; }
  @media (max-width: 600px) {
    .form-embed iframe { height: 1900px; }
    /* On phones, Google's sign-in only works in a new tab: make that a real button. */
    .form-embed .sign-in-note a {
      display: block; margin-top: 12px; padding: 13px 16px; border-radius: 6px;
      background: #245681; color: #fff; text-align: center; text-decoration: none; font-weight: 500;
    }
    .form-embed .note:not(.sign-in-note) a, .links a { display: inline-block; padding: 10px 0; }
  }
  .links { display: flex; flex-wrap: wrap; gap: 28px; margin-top: 28px; }
  .links a { color: #245681; font: 500 14px 'Inter', sans-serif; text-underline-offset: 5px; }
  a:focus-visible { outline: 3px solid #316fa6; outline-offset: 5px; }
  @media (max-width: 600px) { .registration { padding-top: 52px; } }
</style>
