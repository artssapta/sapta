---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SAPTA | Student Artists' Platform",
  description = "SAPTA is a non-profit, student-led organization that promotes Carnatic music. While providing students of all levels opportunities to perform, they also have a way to showcase their talents in unique ways.",
} = Astro.props;

const resolvePath = (p: string) =>
  p.startsWith('/') ? `${import.meta.env.BASE_URL.replace(/\/$/, '')}${p}` : p;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const isActive = (href: string) => {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
};
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="icon" type="image/png" href={resolvePath("/favicon.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={resolvePath("/favicon.png")} />
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "SAPTA",
        "url": "https://saptaarts.org",
        "logo": "https://saptaarts.org/favicon.png",
        "sameAs": [
          "https://sites.google.com/view/saptaarts",
          "https://www.instagram.com/ArtsSapta",
          "https://www.facebook.com/people/SAPTA-Arts/61588073106364/"
        ]
      }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,700;1,400&family=Gentium+Basic:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --sapta-teal: #226E93;
            --sapta-teal-dark: #1e6c93;
            --text-main: rgba(33,33,33,1);
            --font-serif: 'Gentium Basic', serif;
            --font-heading: 'Lora', serif;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: var(--font-serif);
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            background-attachment: fixed;
            color: var(--text-main);
            line-height: 1.6667;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* ===================== */
        /* TOP NAVIGATION        */
        /* ===================== */
        header {
            background: #ffffff;
            position: sticky;
            top: 0;
            z-index: 1000;
            border-bottom: 1px solid #f0f0f0;
            height: 70px;
            display: flex;
            align-items: center;
        }
        nav {
            max-width: 1200px;
            width: 100%;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 20px;
        }
        .nav-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }
        .nav-logo img {
            height: 36px;
            border-radius: 4px;
        }
        .nav-logo span {
            font-family: var(--font-heading);
            font-size: 16pt;
            color: #333333;
            font-weight: 500;
            letter-spacing: 0.5px;
        }
        .nav-links {
            list-style: none;
            display: flex;
            gap: 24px;
            align-items: center;
        }
        .nav-links > li > a,
        .nav-links .dropdown-label {
            font-family: 'Inter', sans-serif;
            font-size: 10.5pt;
            color: #555555;
            font-weight: 500;
            text-decoration: none;
            cursor: pointer;
            transition: color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            padding: 8px 0;
            display: block;
        }
        .nav-links > li > a::after {
            content: '';
            position: absolute;
            width: 100%;
            height: 2px;
            bottom: 0;
            left: 0;
            background-color: #226E93;
            transform: scaleX(0);
            transform-origin: bottom right;
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .nav-links > li > a:hover,
        .nav-links .dropdown:hover .dropdown-label {
            color: #226E93;
        }
        .nav-links > li > a:hover::after,
        .nav-links > li > a.active::after {
            transform: scaleX(1);
            transform-origin: bottom left;
        }
        .nav-links > li > a.active {
            color: #226E93;
        }

        /* Hamburger Menu */
        .hamburger {
            display: none;
            flex-direction: column;
            gap: 6px;
            background: none;
            border: none;
            cursor: pointer;
            padding: 8px;
        }
        .hamburger span {
            width: 24px;
            height: 2px;
            background-color: #555555;
            transition: all 0.3s ease;
            display: block;
        }
        .hamburger.active span:nth-child(1) {
            transform: rotate(45deg) translate(10px, 10px);
        }
        .hamburger.active span:nth-child(2) {
            opacity: 0;
        }
        .hamburger.active span:nth-child(3) {
            transform: rotate(-45deg) translate(7px, -7px);
        }

        /* Donate Button */
        .btn-donate {
            font-family: 'Inter', sans-serif;
            font-size: 10pt;
            font-weight: 600;
            color: #ffffff !important;
            background: var(--sapta-teal);
            padding: 8px 18px !important;
            border-radius: 20px;
            text-decoration: none;
            transition: background 0.2s, transform 0.2s !important;
            display: inline-block;
            letter-spacing: 0.3px;
        }
        .btn-donate::after { display: none !important; }
        .btn-donate:hover {
            background: var(--sapta-teal-dark) !important;
            color: #ffffff !important;
            transform: translateY(-1px);
        }

        /* Dropdowns */
        .dropdown {
            position: relative;
        }
        .dropdown-label::after {
            content: ' ▾';
            font-size: 0.8em;
            vertical-align: middle;
        }
        .dropdown-label.active {
            color: #226E93;
        }
        .dropdown-menu {
            display: none;
            position: absolute;
            background: #ffffff;
            min-width: 180px;
            top: 100%;
            right: 0;
            padding: 8px 0;
            box-shadow: 0 4px 16px rgba(0,0,0,0.08);
            border: 1px solid #e0e0e0;
            border-radius: 4px;
            list-style: none;
            z-index: 1010;
        }
        .dropdown-menu li a {
            display: block;
            padding: 10px 20px;
            font-family: 'Inter', sans-serif;
            font-size: 9.5pt;
            color: #444444;
            text-decoration: none;
            transition: background 0.2s, color 0.2s;
        }
        .dropdown-menu li a:hover,
        .dropdown-menu li a.active {
            background: #f5f5f5;
            color: #226E93;
        }
        .dropdown:hover .dropdown-menu {
            display: block;
        }

        /* Mobile-specific dropdown behavior */
        .dropdown-label {
            user-select: none;
        }
        .dropdown.active .dropdown-menu {
            display: block;
        }

        /* ===================== */
        /* MOBILE RESPONSIVENESS */
        /* ===================== */
        @media (max-width: 768px) {
            header {
                height: auto;
                padding: 12px 0;
            }
            nav {
                padding: 0 16px;
            }
            .nav-logo span {
                font-size: 14pt;
            }
            .hamburger {
                display: flex;
            }
            .nav-links {
                position: absolute;
                top: 70px;
                left: 0;
                right: 0;
                background: #ffffff;
                flex-direction: column;
                gap: 0;
                align-items: stretch;
                padding: 12px 0;
                max-height: 0;
                overflow: hidden;
                transition: max-height 0.3s ease;
                box-shadow: 0 8px 16px rgba(0,0,0,0.08);
                border-bottom: 1px solid #f0f0f0;
            }
            .nav-links.active {
                max-height: 500px;
            }
            .nav-links > li {
                border-bottom: 1px solid #f0f0f0;
            }
            .nav-links > li > a,
            .nav-links .dropdown-label {
                display: block;
                padding: 14px 20px;
                font-size: 10pt;
            }
            .nav-links > li > a::after {
                display: none;
            }
            .nav-links > li > a:hover {
                background: #f5f5f5;
            }
            .dropdown-menu {
                position: static;
                box-shadow: none;
                border: none;
                background: #f9f9f9;
                min-width: auto;
                max-height: 0;
                overflow: hidden;
                transition: max-height 0.3s ease;
            }
            .dropdown.active .dropdown-menu {
                max-height: 200px;
            }
            .dropdown-menu li a {
                padding: 12px 40px;
                font-size: 9.5pt;
            }
            .dropdown-label::after {
                display: inline-block;
                margin-left: 8px;
                transition: transform 0.3s ease;
            }
            .dropdown.active .dropdown-label::after {
                transform: rotate(180deg);
            }
        }

        @media (max-width: 480px) {
            nav {
                padding: 0 12px;
            }
            .nav-logo span {
                font-size: 12pt;
            }
            .nav-links > li > a,
            .nav-links .dropdown-label {
                padding: 12px 16px;
                font-size: 9.5pt;
            }
            .dropdown-menu li a {
                padding: 10px 32px;
            }
            footer {
                padding: 24px 16px;
                font-size: 11pt;
            }
            footer h3 {
                font-size: 13pt;
            }
            footer p {
                font-size: 10pt;
            }
        }

        /* ===================== */
        /* HAMBURGER (MOBILE)    */
        /* ===================== */
        .hamburger {
            display: none;
            flex-direction: column;
            justify-content: space-between;
            width: 26px;
            height: 19px;
            background: none;
            border: none;
            cursor: pointer;
            padding: 0;
            z-index: 1100;
        }
        .hamburger span {
            display: block;
            height: 2px;
            width: 100%;
            background: #333;
            border-radius: 2px;
            transition: all 0.3s ease;
            transform-origin: center;
        }
        .hamburger.open span:nth-child(1) {
            transform: translateY(8.5px) rotate(45deg);
        }
        .hamburger.open span:nth-child(2) {
            opacity: 0;
        }
        .hamburger.open span:nth-child(3) {
            transform: translateY(-8.5px) rotate(-45deg);
        }

        /* Mobile nav panel */
        .mobile-nav {
            display: none;
            position: fixed;
            top: 70px;
            left: 0;
            right: 0;
            background: #ffffff;
            border-bottom: 1px solid #e0e0e0;
            box-shadow: 0 8px 24px rgba(0,0,0,0.08);
            z-index: 999;
            padding: 16px 0 24px;
            animation: slideDown 0.25s ease;
        }
        .mobile-nav.visible { display: block; }
        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-8px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .mobile-nav ul {
            list-style: none;
            padding: 0;
        }
        .mobile-nav ul li a,
        .mobile-nav ul li span {
            display: block;
            padding: 12px 28px;
            font-family: 'Inter', sans-serif;
            font-size: 11pt;
            font-weight: 500;
            color: #444;
            text-decoration: none;
            transition: color 0.2s;
        }
        .mobile-nav ul li a:hover,
        .mobile-nav ul li a.active { color: var(--sapta-teal); }
        .mobile-nav .mobile-sub {
            padding-left: 16px;
        }
        .mobile-nav .mobile-sub li a {
            padding: 9px 28px 9px 44px;
            font-size: 10pt;
            color: #666;
        }
        .mobile-nav .mobile-donate {
            margin: 12px 28px 0;
        }
        .mobile-nav .mobile-donate a {
            display: inline-block;
            padding: 10px 24px;
            background: var(--sapta-teal);
            color: #fff !important;
            border-radius: 20px;
            font-family: 'Inter', sans-serif;
            font-size: 10.5pt;
            font-weight: 600;
            text-decoration: none;
        }
        .mobile-nav .mobile-social {
            display: flex;
            gap: 16px;
            padding: 16px 28px 0;
            align-items: center;
        }
        .mobile-nav .mobile-social a {
            display: flex;
            align-items: center;
            color: #555;
            transition: color 0.2s;
        }
        .mobile-nav .mobile-social a:hover { color: var(--sapta-teal); }

        /* ===================== */
        /* MAIN CONTENT          */
        /* ===================== */
        main {
            flex: 1;
            animation: pageFadeIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        @keyframes pageFadeIn {
            from { opacity: 0; transform: translateY(12px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* ===================== */
        /* SCROLL REVEALS        */
        /* ===================== */
        .reveal {
            opacity: 0;
            transform: translateY(35px) scale(0.985);
            transition: opacity 1.3s cubic-bezier(0.16, 1, 0.3, 1), transform 1.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .reveal-left { transform: translate(-30px, 20px) scale(0.985); }
        .reveal-right { transform: translate(30px, 20px) scale(0.985); }
        .reveal.visible { opacity: 1; transform: translate(0) scale(1); }

        /* ===================== */
        /* FOOTER                */
        /* ===================== */
        footer {
            background-color: #212121;
            color: rgba(255,255,255,0.87);
            font-family: var(--font-heading);
            font-size: 12pt;
        }

        .footer-main {
            display: flex;
            flex-wrap: wrap;
            gap: 40px;
            padding: 40px 48px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .footer-col { flex: 1; min-width: 200px; }

        footer h3 {
            font-size: 13pt;
            font-weight: 500;
            margin-bottom: 12px;
            color: rgba(73, 170, 212, 1);
            letter-spacing: 0.3px;
        }
        footer p {
            font-family: var(--font-serif);
            font-size: 10.5pt;
            color: rgba(255,255,255,0.6);
            margin-bottom: 4px;
        }
        footer a {
            color: rgba(255,255,255,0.6);
            text-decoration: none;
            transition: color 0.2s;
        }
        footer a:hover { color: rgba(73, 170, 212, 1); }

        /* Social icons row */
        .footer-social {
            display: flex;
            gap: 14px;
            margin-top: 14px;
            align-items: center;
        }
        .footer-social a {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            background: rgba(255,255,255,0.07);
            border-radius: 50%;
            color: rgba(255,255,255,0.6);
            transition: background 0.2s, color 0.2s;
        }
        .footer-social a:hover {
            background: var(--sapta-teal);
            color: #fff;
        }

        /* Mailing list */
        .footer-newsletter form {
            display: flex;
            gap: 8px;
            margin-top: 4px;
            flex-wrap: wrap;
        }
        .footer-newsletter input[type="email"] {
            flex: 1;
            min-width: 160px;
            padding: 9px 14px;
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 4px;
            background: rgba(255,255,255,0.07);
            color: #fff;
            font-family: var(--font-serif);
            font-size: 10pt;
            outline: none;
            transition: border-color 0.2s;
        }
        .footer-newsletter input[type="email"]::placeholder { color: rgba(255,255,255,0.35); }
        .footer-newsletter input[type="email"]:focus { border-color: var(--sapta-teal); }
        .footer-newsletter button {
            padding: 9px 18px;
            background: var(--sapta-teal);
            color: #fff;
            border: none;
            border-radius: 4px;
            font-family: 'Inter', sans-serif;
            font-size: 9.5pt;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
            white-space: nowrap;
        }
        .footer-newsletter button:hover { background: #1a5d7e; }

        /* Footer bottom bar */
        .footer-bottom {
            padding: 16px 48px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
        }
        .footer-bottom p {
            font-size: 9.5pt;
            color: rgba(255,255,255,0.35);
            font-family: var(--font-serif);
            margin: 0;
        }

        /* ===================== */
        /* RESPONSIVE            */
        /* ===================== */
        @media (max-width: 767px) {
            .nav-links { display: none; }
            .hamburger { display: flex; }

            .footer-main { padding: 32px 24px; gap: 28px; }
            .footer-bottom { padding: 14px 24px; }
        }
    </style>
</head>
<body>

    <header>
        <nav>
            <a href={resolvePath('/')} class="nav-logo">
                <img src={resolvePath("/assets/image_186b79.png")} alt="SAPTA Logo">
                <span>SAPTA</span>
            </a>
            <button class="hamburger" id="hamburger" aria-label="Toggle menu">
                <span></span>
                <span></span>
                <span></span>
            </button>
            <ul class="nav-links">
                <li><a href={resolvePath('/')} class={isActive('/') ? 'active' : ''}>About Us</a></li>
                <li><a href={resolvePath('/events')} class={isActive('/events') ? 'active' : ''}>Events</a></li>
                <li><a href={resolvePath('/feedback')} class={isActive('/feedback') ? 'active' : ''}>Feedback</a></li>
                <li class="dropdown">
                    <span class={`dropdown-label ${isActive('/registration') ? 'active' : ''}`}>Registration</span>
                    <ul class="dropdown-menu">
                        <li><a href={resolvePath('/registration/group')} class={isActive('/registration/group') ? 'active' : ''}>Group Registration</a></li>
                    </ul>
                </li>
                <!-- Social icons in nav (desktop) -->
                <li>
                    <a href="https://www.instagram.com/ArtsSapta" target="_blank" rel="noopener" title="Instagram" style="padding: 8px 2px; display:flex; align-items:center;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                    </a>
                </li>
                <li>
                    <a href="https://www.facebook.com/people/SAPTA-Arts/61588073106364/" target="_blank" rel="noopener" title="Facebook" style="padding: 8px 2px; display:flex; align-items:center;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                    </a>
                </li>
                <li>
                    <a href="#donate" class="btn-donate">Donate</a>
                </li>
            </ul>

            <!-- Hamburger for mobile -->
            <button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </nav>
    </header>

    <!-- Mobile nav panel -->
    <div class="mobile-nav" id="mobile-nav" role="navigation" aria-label="Mobile navigation">
        <ul>
            <li><a href={resolvePath('/')} class={isActive('/') ? 'active' : ''}>About Us</a></li>
            <li><a href={resolvePath('/events')} class={isActive('/events') ? 'active' : ''}>Events</a></li>
            <li><a href={resolvePath('/feedback')} class={isActive('/feedback') ? 'active' : ''}>Feedback</a></li>
            <li>
                <span style="font-family:'Inter',sans-serif; font-size:11pt; font-weight:600; color:#888; padding:10px 28px 4px; display:block; font-size:9pt; text-transform:uppercase; letter-spacing:0.5px;">Registration</span>
                <ul class="mobile-sub">
                    <li><a href={resolvePath('/registration/spotlight')}>Sapta Spotlight</a></li>
                    <li><a href={resolvePath('/registration/group')}>Group Registration</a></li>
                </ul>
            </li>
        </ul>
        <div class="mobile-donate">
            <a href="#donate">Donate</a>
        </div>
        <div class="mobile-social">
            <a href="https://www.instagram.com/ArtsSapta" target="_blank" rel="noopener" title="Instagram">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
            <a href="https://www.facebook.com/people/SAPTA-Arts/61588073106364/" target="_blank" rel="noopener" title="Facebook">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
        </div>
    </div>

    <main>
        <slot />
    </main>

    <footer>
        <div class="footer-main">
            <!-- Contact -->
            <div class="footer-col">
                <h3>Contact Us</h3>
                <p>Email: <a href="mailto:artssapta@gmail.com">artssapta@gmail.com</a></p>
                <div class="footer-social">
                    <a href="https://www.instagram.com/ArtsSapta" target="_blank" rel="noopener" title="Instagram">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                    </a>
                    <a href="https://www.facebook.com/people/SAPTA-Arts/61588073106364/" target="_blank" rel="noopener" title="Facebook">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                    </a>
                </div>
            </div>


        </div>

        <div class="footer-bottom">
            <p>© {new Date().getFullYear()} SAPTA — Student Artists' Platform. All rights reserved.</p>
            <p>Serving the Tri-Valley community.</p>
        </div>
    </footer>


    <script is:inline>
        /* Scroll reveal */
        function initScrollReveal() {
            const reveals = document.querySelectorAll('.reveal:not(.visible)');
            const observer = new IntersectionObserver((entries, obs) => {
                let delay = 0;
                const intersecting = entries
                    .filter(e => e.isIntersecting)
                    .sort((a, b) => a.target.getBoundingClientRect().top - b.target.getBoundingClientRect().top);
                intersecting.forEach(entry => {
                    const el = entry.target;
                    obs.unobserve(el);
                    setTimeout(() => el.classList.add('visible'), delay);
                    delay += 100;
                });
            }, { threshold: 0.04, rootMargin: '0px 0px -30px 0px' });
            reveals.forEach(el => observer.observe(el));
        }
        document.addEventListener('DOMContentLoaded', () => {
            initScrollReveal();
            
            const hamburger = document.getElementById('hamburger');
            const mobileNav = document.getElementById('mobile-nav');

            if (hamburger && mobileNav) {
                hamburger.addEventListener('click', () => {
                    const isOpen = mobileNav.classList.toggle('visible');
                    hamburger.classList.toggle('open', isOpen);
                    hamburger.setAttribute('aria-expanded', isOpen.toString());
                });

                mobileNav.querySelectorAll('a').forEach(link => {
                    link.addEventListener('click', () => {
                        mobileNav.classList.remove('visible');
                        hamburger.classList.remove('open');
                        hamburger.setAttribute('aria-expanded', 'false');
                    });
                });
            }
        });

        function handleNewsletterSubmit(e) {
            e.preventDefault();
            const form = e.target;
            const msg = document.getElementById('newsletter-msg');
            fetch('/', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams(new FormData(form)).toString()
            }).then(() => {
                form.style.display = 'none';
                msg.style.display = 'block';
            }).catch(() => {
                msg.textContent = "You're subscribed! We'll be in touch.";
                form.style.display = 'none';
                msg.style.display = 'block';
            });
        }
    </script>

</body>
</html>
