---
import { getEntry } from 'astro:content';
import Layout from '../../components/Layout.astro';
import Registration from '../../components/Registration.astro';
const page = await getEntry('registrations', 'group');
if (!page) throw new Error('Missing registration settings');
---
<Layout title={`${page.data.title} | SAPTA`}>
  <Registration {...page.data} />
</Layout>
