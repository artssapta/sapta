---
import { getEntry } from 'astro:content';
import Layout from '../../components/Layout.astro';
import Events from '../../components/blocks/Events.astro';
const event = await getEntry('events', 'go-rakshana');
if (!event) throw new Error('Missing Go-Rakshana event');
---
<Layout title="Go Rakshana | SAPTA">
  <Events title="Go Rakshana" events={[{ ...event.data, id: event.id }]} />
</Layout>
